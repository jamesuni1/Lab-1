#include "mbed.h"


// Blinking rate in milliseconds
#define BLINKING_RATE     200ms

//defining the leds
DigitalOut led1(LED1);
DigitalOut led2(LED2);
DigitalOut led3(LED3);

// the function
void PingPong() {
    led1 = 1;
    ThisThread::sleep_for(BLINKING_RATE);
    led1 = 0;
    ThisThread::sleep_for(BLINKING_RATE);

    led2 = 1;
    ThisThread::sleep_for(BLINKING_RATE);
    led2 = 0;
    ThisThread::sleep_for(BLINKING_RATE);

    led3 = 1;
    ThisThread::sleep_for(BLINKING_RATE);
    led3 = 0;
    ThisThread::sleep_for(BLINKING_RATE);

    led2 = 1;
    ThisThread::sleep_for(BLINKING_RATE);
    led2 = 0;
    ThisThread::sleep_for(BLINKING_RATE);
}

int main()
{
    led1 = 0;
    led2 = 0;
    led3 = 0;

    int count =  0;

    while (true) {
        // call the function
        PingPong();
    }
}

